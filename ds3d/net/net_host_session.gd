class_name NetHostSession
extends RefCounted

## The session authority for Slice 4. Owns the one authoritative Host and
## the bus endpoint the clients connect to. Clients send commands; the
## host collects each round's commands, orders them canonically (tick,
## player_id, action, params — so the applied order is a deterministic
## function of the round's command SET, never of wire arrival order),
## feeds them to the sim, steps exactly once, and broadcasts a tick
## bundle: the commands it actually applied that step, in applied order.
## Clients feed bundles into their replicas, so every sim in the session
## consumes byte-identical input. Provenance (which endpoint each applied
## command came from) is tracked parallel to the host's command log.

const Host = preload("res://sim/host.gd")

var bus # LoopbackBus or TcpBus (duck-typed endpoint)
var host: Host
var clients: Dictionary = {} # endpoint_id -> side
var applied_sources: Array = [] # parallel to host.command_log: endpoint id, or "host"
var provenance_misaligned: bool = false
var rounds: int = 0
var match_end_sent: bool = false

var _ready: Dictionary = {} # endpoint_id -> last round_ready round
var _round_inbox: Array = [] # [{cmd, from}] collected since the last step
var _pending_sources: Array = [] # FIFO, aligned with the sim's unconsumed pending queue
var _cmd_log_cursor: int = 0

func _init(p_bus) -> void:
	bus = p_bus
	host = Host.new(true)

static func ledger_hash(events: Array) -> String:
	var ctx := HashingContext.new()
	ctx.start(HashingContext.HASH_MD5)
	ctx.update(JSON.stringify(events).to_utf8_buffer())
	return ctx.finish().hex_encode()

func get_command_log() -> Array:
	return host.get_command_log()

func get_event_log() -> Array:
	return host.get_event_log()

## Drain the bus once, processing hellos, commands, and round readys.
func poll_messages() -> void:
	for item in bus.poll():
		var from_id: String = item["from"]
		var msg: Dictionary = item["msg"]
		match String(msg.get("type", "")):
			"hello":
				clients[from_id] = String(msg.get("side", ""))
				bus.send(from_id, {"type": "welcome", "side": String(msg.get("side", ""))})
			"command":
				_round_inbox.append({"cmd": msg["cmd"], "from": from_id})
			"round_ready":
				_ready[from_id] = int(msg.get("round", -1))

func all_clients_ready(round_idx: int) -> bool:
	if clients.size() < 2:
		return false
	for id in clients:
		if int(_ready.get(id, -1)) != round_idx:
			return false
	return true

## One round: wait (by polling) until both clients have signaled
## round_ready for this round, submit the round's commands in canonical
## order, step the host exactly once, and broadcast the tick bundle.
## Returns false only if the wait cap is exhausted (transport failure).
func step_round(round_idx: int, wait_cap: int = 200000) -> bool:
	var spins := 0
	while not all_clients_ready(round_idx):
		poll_messages()
		spins += 1
		if spins % 1000 == 0:
			OS.delay_msec(1)
		if spins > wait_cap:
			return false
	poll_messages() # final drain — commands precede their sender's ready on the wire
	_submit_round_inbox()
	var cursor_before: int = host.pending_cursor
	host.step()
	var consumed: int = host.pending_cursor - cursor_before
	var new_cmds: Array = []
	var idx := 0
	for i in range(_cmd_log_cursor, host.command_log.size()):
		var cmd: Dictionary = host.command_log[i]
		new_cmds.append(cmd)
		if idx < consumed:
			applied_sources.append(String(_pending_sources.pop_front()) if _pending_sources.size() > 0 else "misaligned")
			if applied_sources[applied_sources.size() - 1] == "misaligned":
				provenance_misaligned = true
		else:
			applied_sources.append("host") # generated by the sim itself (SPAWN_WAVE)
		idx += 1
	_cmd_log_cursor = host.command_log.size()
	rounds += 1
	var bundle := {"type": "tick_bundle", "round": round_idx, "tick": host.tick - 1, "commands": new_cmds}
	for id in clients:
		bus.send(id, bundle)
	return true

func _submit_round_inbox() -> void:
	var keyed: Array = []
	for entry in _round_inbox:
		var cmd: Dictionary = entry["cmd"]
		keyed.append([int(cmd.get("tick", 0)), String(cmd.get("player_id", "")), String(cmd.get("action", "")), JSON.stringify(cmd.get("params", {})), cmd, String(entry["from"])])
	keyed.sort_custom(func(a: Array, b: Array) -> bool:
		for k in range(4):
			if a[k] < b[k]:
				return true
			if a[k] > b[k]:
				return false
		return false)
	for entry in keyed:
		host.submit_command(entry[4])
		_pending_sources.append(entry[5])
	_round_inbox.clear()

## After the match: tell every client the final tick and the host's
## ledger hash, so each can check its replica against the authority.
func finish() -> void:
	var info := {"type": "match_end", "final_tick": host.tick, "ledger_hash": ledger_hash(host.get_event_log()), "winner": host.winner}
	for id in clients:
		bus.send(id, info)
	match_end_sent = true
